# .streamlit/secrets.toml.example
# 
# INSTRUCTIONS FOR STREAMLIT CLOUD DEPLOYMENT:
# 1. Go to your Streamlit Cloud app settings
# 2. Navigate to "Secrets" section
# 3. Paste the content below (with YOUR real credentials)
# 4. DO NOT commit this file to git (already in .gitignore)

[fyers]
CLIENT_ID = "YOUR_CLIENT_ID_HERE-100"
SECRET_KEY = "YOUR_SECRET_KEY_HERE"
REDIRECT_URI = "https://trade.fyers.in/api-login/redirect-uri/index.html"

# Note: ACCESS_TOKEN will be generated after OAuth login
# For cloud deployment, you'll need to handle token refresh
